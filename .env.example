# =============================================================================
# Skill to Hire — Environment Variables Template
# Copy to .env for local/self-hosted runs. Never commit real secrets to git.
# In Google AI Studio, GEMINI_API_KEY is managed via Settings > Secrets.
# =============================================================================

# --- Server Runtime ---
PORT=3000
NODE_ENV=development
DISABLE_HMR=false

# --- Gemini AI (Server-side only — never prefix with VITE_) ---
GEMINI_API_KEY=

# --- Optional SMTP (Password Reset OTP Emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Optional Firebase Web Config Overrides (Defaults to firebase-applet-config.json) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=
