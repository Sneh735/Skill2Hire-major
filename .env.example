# GEMINI_API_KEY: Required for server-side Gemini AI features.
# In Google AI Studio, this is injected automatically or set via Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional server/SMTP variables (uncomment only if configuring custom SMTP email):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=
